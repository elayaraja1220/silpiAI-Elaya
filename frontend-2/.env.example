NEXT_PUBLIC_APP_NAME="SILPI AI"

# Absolute path to the SILPI agent (silpi-agent) folder. Use forward slashes on Windows.
SILPI_AGENT_DIR="C:/path/to/SilpiAgent/silpi-agent"

# Optional. Where generated projects are written, relative to SILPI_AGENT_DIR.
# Keep this identical to SILPI_OUTPUT_DIR in the agent's .env if set.
SILPI_OUTPUT_DIR="../generated-projects"

# Admin sign-in for the Execution settings and the project-generation controls.
# A long random secret (16+ characters). Without it those screens and APIs stay CLOSED.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SILPI_ADMIN_TOKEN=

# Optional. Where generated projects are written when there is no SILPI_AGENT_DIR (absolute path).
# SILPI_WORKSPACE_DIR="C:/path/to/generated-projects"

# ---- SILPI AI billing, payments and AI (see docs/DEPLOYMENT.md) ----
# Where the database file lives. Use a path on a disk that survives restarts. Default: frontend-2/storage/silpi.db
# SILPI_DB_PATH="/var/lib/silpi/silpi.db"

# AI providers. Each key switches that provider on; without any, only the free demo model works.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Renewals, past-due handling and credit expiry on a timer. Default: on in production, off elsewhere.
# SILPI_AUTO_BILLING=1
# SILPI_BILLING_INTERVAL_MINUTES=60

# ---- Client accounts (see docs/CLIENT_AUTH_ANALYSIS.md). Put real values ONLY in .env.local, never in this file. ----
# The site's own public address. Password-reset links and the Google/Facebook return addresses are built from it.
# Required on a production server; on a development server the request's address is used.
# SILPI_PUBLIC_URL="https://app.your-domain.com"

# E-mail for password resets. Until SMTP_HOST and SMTP_FROM are set, the message is printed in the server console and NOT sent.
# SILPI_SMTP_HOST=
# SILPI_SMTP_PORT=587
# SILPI_SMTP_USER=
# SILPI_SMTP_PASSWORD=
# SILPI_SMTP_FROM="SILPI AI <no-reply@your-domain.com>"

# Google sign-in (console.cloud.google.com). Return address to register: <SILPI_PUBLIC_URL>/api/auth/oauth/google/callback
# SILPI_GOOGLE_CLIENT_ID=
# SILPI_GOOGLE_CLIENT_SECRET=

# Facebook sign-in (developers.facebook.com). Return address to register: <SILPI_PUBLIC_URL>/api/auth/oauth/facebook/callback
# SILPI_FACEBOOK_APP_ID=
# SILPI_FACEBOOK_APP_SECRET=
