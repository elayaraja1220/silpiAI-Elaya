NEXT_PUBLIC_APP_NAME="SILPI AI"

# Absolute path to the SILPI agent (silpi-agent) folder. Use forward slashes on Windows.
SILPI_AGENT_DIR="C:/path/to/SilpiAgent/silpi-agent"

# Optional. Where generated projects are written, relative to SILPI_AGENT_DIR.
# Keep this identical to SILPI_OUTPUT_DIR in the agent's .env if set.
SILPI_OUTPUT_DIR="../generated-projects"
