# Required. Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# SILPI_MODEL=claude-opus-5-5
# Reasoning depth: low | medium | high | xhigh | max (higher = better results, more tokens)
# SILPI_EFFORT=high
# Hard stop for one run, in model turns
# SILPI_MAX_TURNS=150

# Where projects are written, relative to this folder
# SILPI_OUTPUT_DIR=../generated-projects

# Per-command timeouts (milliseconds)
# SILPI_COMMAND_TIMEOUT_MS=600000
# SILPI_INSTALL_TIMEOUT_MS=900000
